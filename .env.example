# ── Monatt Trend Intelligence — environment variables ─────────────────
# Copy this file to `.env.local` and fill in what you have.
# The app runs WITHOUT any of these (using a local file database and
# clearly-labeled sample data). Each key you add unlocks a capability.

# 1) Supabase (optional — persistent cloud database)
#    Create a free project at https://supabase.com, then find these under
#    Project Settings → API. Use the *service_role* key — it is only ever
#    used server-side in this app and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2) Anthropic API (optional — AI trend commentary, AI product concepts,
#    AI weekly-brief narrative). Get a key at https://console.anthropic.com
#    Without it, the app falls back to transparent rule-based generation,
#    clearly labeled in the UI.
ANTHROPIC_API_KEY=
